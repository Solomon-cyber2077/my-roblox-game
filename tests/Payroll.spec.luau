local Payroll = require(Shared.Logic.Payroll)

describe("Payroll", function()
	it("credits only net forward progress and updates the nearest record", function()
		local state = Payroll.new(100)
		Payroll.join(state, 1)
		expect(Payroll.sample(state, 80)).toBe(20)
		expect(state.byCarrier[1]).toBe(0)
		Payroll.join(state, 2)
		expect(Payroll.sample(state, 70)).toBe(10)
		expect(Payroll.sample(state, 90)).toBe(0)
		expect(Payroll.sample(state, 60)).toBe(10)
		expect(state.byCarrier[1]).toBe(20)
		expect(state.byCarrier[2]).toBe(20)
		expect(state.nearest).toBe(60)
	end)

	it("requires two carriers for the double and uses the exact boundary", function()
		local state = Payroll.new(100)
		Payroll.join(state, 1)
		Payroll.join(state, 2)
		Payroll.sample(state, 40)
		expect(state.duo).toBe(60)
		expect(Payroll.eligible(state)).toBe(true)
	end)

	it("never doubles solo progress", function()
		local state = Payroll.new(100)
		Payroll.join(state, 1)
		Payroll.sample(state, 0)
		expect(state.duo).toBe(0)
		expect(Payroll.eligible(state)).toBe(false)
	end)

	it("caps carriers, rejects duplicates, and preserves accounting over drops and swaps", function()
		local state = Payroll.new(100)
		expect(Payroll.join(state, 1)).toBe(true)
		expect(Payroll.join(state, 1)).toBe(false)
		expect(Payroll.join(state, 2)).toBe(true)
		expect(Payroll.join(state, 3)).toBe(false)
		Payroll.sample(state, 80)
		Payroll.leave(state, 1)
		expect(Payroll.join(state, 3)).toBe(true)
		Payroll.sample(state, 50)
		-- The pair earns 20 studs before the swap and 30 after it.
		expect(state.duo).toBe(50)
		expect(state.byCarrier[2]).toBe(50)
		expect(state.byCarrier[3]).toBe(30)
	end)

	it("does not credit unheld movement, then resumes the same route after recovery", function()
		local state = Payroll.new(100)
		Payroll.join(state, 1)
		Payroll.join(state, 2)
		expect(Payroll.sample(state, 80)).toBe(20)
		Payroll.leave(state, 1)
		Payroll.leave(state, 2)
		expect(Payroll.sample(state, 60)).toBe(0)
		expect(state.duo).toBe(20)
		expect(state.byCarrier[1]).toBe(20)
		expect(state.byCarrier[2]).toBe(20)
		Payroll.join(state, 2)
		Payroll.join(state, 3)
		expect(Payroll.sample(state, 40)).toBe(20)
		expect(state.duo).toBe(40)
		expect(state.byCarrier[2]).toBe(40)
		expect(state.byCarrier[3]).toBe(20)
	end)

	it("keeps a duo threshold through disconnect handoff and never credits a solo final leg", function()
		local state = Payroll.new(100)
		Payroll.join(state, 1)
		Payroll.join(state, 2)
		Payroll.sample(state, 40)
		expect(state.duo).toBe(60)
		expect(Payroll.leave(state, 1)).toBe(true)
		expect(#state.carriers).toBe(1)
		expect(Payroll.sample(state, 10)).toBe(30)
		expect(state.duo).toBe(60)
		expect(state.byCarrier[2]).toBe(60)
		expect(Payroll.eligible(state)).toBe(true)
		expect(Payroll.deliver(state)).toBe(true)
	end)

	it("delivers exactly once and handles zero routes", function()
		local state = Payroll.new(0)
		expect(Payroll.eligible(state)).toBe(false)
		expect(Payroll.deliver(state)).toBe(false)
		local route = Payroll.new(100)
		Payroll.join(route, 1)
		Payroll.join(route, 2)
		Payroll.sample(route, 40)
		expect(Payroll.deliver(route)).toBe(true)
		expect(Payroll.deliver(route)).toBe(false)
		expect(#route.carriers).toBe(0)
		expect(Payroll.sample(route, 0)).toBe(0)
	end)

	it("marks an ineligible solo delivery complete without doubling", function()
		local state = Payroll.new(100)
		Payroll.join(state, 1)
		Payroll.sample(state, 20)
		expect(Payroll.deliver(state)).toBe(false)
		expect(state.delivered).toBe(true)
		expect(#state.carriers).toBe(0)
		expect(Payroll.join(state, 2)).toBe(false)
		expect(Payroll.sample(state, 0)).toBe(0)
		expect(Payroll.deliver(state)).toBe(false)
	end)
end)

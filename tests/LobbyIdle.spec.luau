local LobbyIdle = require(Shared.Logic.LobbyIdle)

describe("LobbyIdle", function()
	it("waits for the supplied delay and attempts once", function()
		local state = LobbyIdle.new(10, 12)
		expect(LobbyIdle.step(state, 10, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 21.99, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 22, true, false)).toBe(true)
		expect(LobbyIdle.step(state, 30, true, false)).toBe(false)
	end)

	it("resets while blocked or held", function()
		local state = LobbyIdle.new(0, 5)
		expect(LobbyIdle.step(state, 5, false, false)).toBe(false)
		expect(LobbyIdle.step(state, 5, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 6, true, true)).toBe(false)
		expect(LobbyIdle.step(state, 10.99, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 11, true, false)).toBe(true)
	end)

	it("supports an explicit reset and backward clock", function()
		local state = LobbyIdle.new(10, 2)
		expect(LobbyIdle.step(state, 10, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 12, true, false)).toBe(true)
		LobbyIdle.reset(state, 30)
		expect(LobbyIdle.step(state, 31, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 29, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 31, true, false)).toBe(true)
		expect(LobbyIdle.step(state, 32, true, false)).toBe(false)
	end)

	it("requires a fresh eligibility interval and detects backward samples", function()
		local state = LobbyIdle.new(0, 12)
		expect(LobbyIdle.step(state, 0, false, false)).toBe(false)
		expect(LobbyIdle.step(state, 12, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 12.01, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 23.99, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 24, true, false)).toBe(true)
		expect(LobbyIdle.step(state, 25, true, false)).toBe(false)
		expect(LobbyIdle.step(state, 24, true, false)).toBe(false)
	end)

	it("rejects invalid constructor values", function()
		local finiteOk = pcall(function()
			LobbyIdle.new(math.huge, 1)
		end)
		local delayOk = pcall(function()
			LobbyIdle.new(0, -1)
		end)
		expect(finiteOk).toBe(false)
		expect(delayOk).toBe(false)
	end)
end)

local Inventory = require(Shared.Logic.Inventory)
local Tuning = require(Shared.Config.Tuning)

describe("Inventory", function()
	it("starts empty with the base slot count", function()
		local inv = Inventory.new()
		expect(inv.capacity).toBe(Tuning.Crew.BackpackSlots)
		expect(Inventory.used(inv)).toBe(0)
	end)

	it("counts heavy items as two slots", function()
		local inv = Inventory.new(4)
		inv = Inventory.add(inv, "CoalSack")
		expect(Inventory.used(inv)).toBe(2)
		inv = Inventory.add(inv, "GearCrate")
		expect(Inventory.used(inv)).toBe(4)
		local _, ok = Inventory.add(inv, "Scrap")
		expect(ok).toBe(false)
	end)

	it("never mutates the previous state", function()
		local a = Inventory.new(4)
		local b = Inventory.add(a, "Scrap")
		expect(#a.items).toBe(0)
		expect(#b.items).toBe(1)
	end)

	it("slows by 14% per heavy item, stacking", function()
		local inv = Inventory.new(4)
		expect(Inventory.speedMultiplier(inv)).toBe(1)
		inv = Inventory.add(inv, "CoalSack")
		expect(Inventory.speedMultiplier(inv)).toBeCloseTo(0.86)
		inv = Inventory.add(inv, "CoalSack")
		expect(Inventory.speedMultiplier(inv)).toBeCloseTo(0.86 * 0.86)
	end)

	it("deposits cargo and relics but keeps tools", function()
		local inv = Inventory.new(6)
		inv = Inventory.addMany(inv, { "Flare", "CoalLump", "PocketWatch", "Tonic", "Scrap" })
		local kept, cargo = Inventory.splitCargo(inv)
		expect(#kept.items).toBe(2)
		expect(#cargo).toBe(3)
		expect(Inventory.hasCargo(kept)).toBe(false)
	end)

	it("returns leftovers that do not fit", function()
		local inv, leftovers = Inventory.addMany(Inventory.new(3), { "CoalSack", "CoalSack", "Scrap" })
		expect(#inv.items).toBe(2)
		expect(#leftovers).toBe(1)
		expect(leftovers[1]).toBe("CoalSack")
	end)

	it("puts a tool in the hand on its key and away on the same key", function()
		local inv = Inventory.addMany(Inventory.new(6), { "Scrap", "Flare", "Tonic" })
		expect(Inventory.select(inv, nil, 2)).toBe(2)
		expect(Inventory.select(inv, 2, 3)).toBe(3)
		expect(Inventory.select(inv, 2, 2)).toBe(nil)
	end)

	it("ignores keys of slots without a tool", function()
		local inv = Inventory.addMany(Inventory.new(6), { "Scrap", "Flare" })
		expect(Inventory.select(inv, 2, 1)).toBe(2)
		expect(Inventory.select(inv, nil, 5)).toBe(nil)
	end)

	it("keeps the hand on its item as the backpack changes", function()
		local inv = Inventory.addMany(Inventory.new(6), { "Scrap", "Flare" })
		local after = Inventory.removeAt(inv, 1)
		expect(Inventory.follow(after, 2, "Flare")).toBe(1)
		local gone = Inventory.removeAt(after, 1)
		expect(Inventory.follow(gone, 1, "Flare")).toBe(nil)
		expect(Inventory.follow(inv, 2, "Flare")).toBe(2)
	end)

	it("uses the hand on E only while no interact prompt is showing", function()
		local inv = Inventory.addMany(Inventory.new(6), { "Scrap", "Flare" })
		expect(Inventory.canUseHand(inv, 2, false)).toBe(true)
		expect(Inventory.canUseHand(inv, 2, true)).toBe(false)
		expect(Inventory.canUseHand(inv, nil, false)).toBe(false)
		expect(Inventory.canUseHand(inv, 1, false)).toBe(false)
	end)
end)

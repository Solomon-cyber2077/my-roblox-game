local CrewChest = require(Shared.Logic.CrewChest)
local Inventory = require(Shared.Logic.Inventory)

local function bag(items: { string })
	local inv = Inventory.new(6)
	for _, id in items do
		inv = (Inventory.add(inv, id))
	end
	return inv
end

describe("CrewChest", function()
	it("stores consumables only", function()
		expect(CrewChest.storable("Flare")).toBe(true)
		expect(CrewChest.storable("Tonic")).toBe(true)
		expect(CrewChest.storable("Flashbulb")).toBe(true)
		expect(CrewChest.storable("CoalLump")).toBe(false)
		expect(CrewChest.storable("PocketWatch")).toBe(false)
		expect(CrewChest.storable("TicketStub")).toBe(false)
		expect(CrewChest.storable(nil)).toBe(false)
	end)

	it("stows from a slot and takes back by id", function()
		local chest, inv, reason = CrewChest.stow({}, bag({ "CoalLump", "Flare" }), 2)
		expect(reason).toBe(nil)
		expect(#chest).toBe(1)
		expect(#inv.items).toBe(1)
		local again, back, why = CrewChest.take(chest, inv, "Flare")
		expect(why).toBe(nil)
		expect(#again).toBe(0)
		expect(back.items[2]).toBe("Flare")
	end)

	it("refuses what it cannot do and changes nothing", function()
		local inv = bag({ "CoalLump" })
		local chest, same, reason = CrewChest.stow({}, inv, 1)
		expect(reason).toBe("NotStorable")
		expect(#chest).toBe(0)
		expect(same).toBe(inv)
		expect(select(3, CrewChest.stow({}, inv, 4))).toBe("Empty")
		local full = table.create(CrewChest.Capacity, "Tonic")
		expect(select(3, CrewChest.stow(full, bag({ "Flare" }), 1))).toBe("Full")
		expect(select(3, CrewChest.take({}, inv, "Flare"))).toBe("Missing")
		local packed = bag({ "Tonic", "Tonic", "Tonic", "Tonic", "Tonic", "Tonic" })
		expect(select(3, CrewChest.take({ "Flare" }, packed, "Flare"))).toBe("NoRoom")
	end)

	it("counts by item, in name order", function()
		local counts, order = CrewChest.counts({ "Tonic", "Flare", "Tonic" })
		expect(counts.Tonic).toBe(2)
		expect(counts.Flare).toBe(1)
		expect(order[1]).toBe("Flare")
		expect(order[2]).toBe("Tonic")
	end)
end)

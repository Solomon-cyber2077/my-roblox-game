local Visibility = require(Shared.Logic.Visibility)
local Tuning = require(Shared.Config.Tuning)

local V = Tuning.Visibility

describe("Visibility", function()
	it("keeps the floor's reach inside the slider's range", function()
		expect(Visibility.radius(nil)).toBe(V.Default)
		expect(Visibility.radius("far")).toBe(V.Default)
		expect(Visibility.radius(0 / 0)).toBe(V.Default)
		expect(Visibility.radius(1)).toBe(V.RadiusMin)
		expect(Visibility.radius(999)).toBe(V.RadiusMax)
		expect(Visibility.radius(24)).toBe(24)
	end)

	it("never lets the floor fall under its default, and lifts it with more reach", function()
		expect(Visibility.scale(V.Radius)).toBe(1)
		expect(Visibility.scale(V.RadiusMin)).toBeAtLeast(1)
		expect(Visibility.scale(V.RadiusMax)).toBeGreaterThan(1)
		local r = Visibility.floor(V.AmbientFloor, V.Radius)
		expect(r).toBe(V.AmbientFloor[1])
		local far = Visibility.floor(V.OutdoorFloor, V.RadiusMax)
		expect(far).toBeGreaterThan(V.OutdoorFloor[1])
		expect(far).toBeAtMost(255)
	end)

	it("covers at least the lantern's old reach", function()
		expect(V.Radius).toBeAtLeast(16)
		expect(V.RadiusMin).toBeAtMost(V.Radius)
		expect(V.DensityCap).toBeLessThan(0.78)
	end)
end)

describe("Visibility chase", function()
	local C = Tuning.Visibility.Chase

	it("flickers black at once, then holds the dark while chased", function()
		local s = Visibility.chaseStep(Visibility.chaseStart(), true, 10)
		expect(s.mode).toBe("Chase")
		expect(Visibility.chaseLook(s, 10).black).toBeGreaterThan(0.5)
		local later = Visibility.chaseLook(s, 12)
		expect(later.black).toBe(0)
		expect(later.dim).toBe(1)
	end)

	it("waits Hold seconds out of detection, then snaps to relief, then settles", function()
		local s = Visibility.chaseStep(Visibility.chaseStart(), true, 0)
		s = Visibility.chaseStep(s, false, 5)
		expect(s.mode).toBe("Hold")
		expect(Visibility.chaseLook(s, 5).dim).toBe(1)
		s = Visibility.chaseStep(s, false, 5 + C.Hold - 0.1)
		expect(s.mode).toBe("Hold")
		s = Visibility.chaseStep(s, false, 5 + C.Hold)
		expect(s.mode).toBe("Relief")
		local look = Visibility.chaseLook(s, 5 + C.Hold)
		expect(look.dim).toBe(0)
		expect(look.relief).toBe(1)
		expect(Visibility.chaseLook(s, 5 + C.Hold + C.ReliefFade / 2).relief).toBeLessThan(1)
		s = Visibility.chaseStep(s, false, 5 + C.Hold + C.ReliefFade)
		expect(s.mode).toBe("Calm")
	end)

	it("does not flicker again when caught again before the relief", function()
		local s = Visibility.chaseStep(Visibility.chaseStart(), true, 0)
		s = Visibility.chaseStep(s, false, 2)
		s = Visibility.chaseStep(s, true, 3)
		expect(s.mode).toBe("Chase")
		expect(Visibility.chaseLook(s, 3).black).toBe(0)
		-- a fresh chase after the relief flickers again
		s = Visibility.chaseStep(s, false, 4)
		s = Visibility.chaseStep(s, false, 4 + C.Hold)
		s = Visibility.chaseStep(s, true, 5 + C.Hold)
		expect(Visibility.chaseLook(s, 5 + C.Hold).black).toBeGreaterThan(0.5)
	end)
end)

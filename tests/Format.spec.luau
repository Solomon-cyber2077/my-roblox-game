local Format = require(Shared.Util.Format)

describe("Format.clock", function()
	it("rounds up so a running countdown never shows 0:00", function()
		expect(Format.clock(65.2)).toBe("1:06")
		expect(Format.clock(0.1)).toBe("0:01")
		expect(Format.clock(60)).toBe("1:00")
	end)

	it("pads seconds and stops at zero", function()
		expect(Format.clock(9)).toBe("0:09")
		expect(Format.clock(0)).toBe("0:00")
		expect(Format.clock(-5)).toBe("0:00")
		expect(Format.clock(3725)).toBe("62:05")
	end)
end)

describe("Format.thousands", function()
	it("groups digits in threes", function()
		expect(Format.thousands(0)).toBe("0")
		expect(Format.thousands(999)).toBe("999")
		expect(Format.thousands(1000)).toBe("1,000")
		expect(Format.thousands(1250)).toBe("1,250")
		expect(Format.thousands(123456)).toBe("123,456")
		expect(Format.thousands(1234567)).toBe("1,234,567")
	end)

	it("rounds to the nearest whole number", function()
		expect(Format.thousands(1249.5)).toBe("1,250")
		expect(Format.thousands(1249.4)).toBe("1,249")
	end)

	it("keeps the sign, but never prints -0", function()
		expect(Format.thousands(-1250)).toBe("-1,250")
		expect(Format.thousands(-999)).toBe("-999")
		expect(Format.thousands(-0.4)).toBe("0")
	end)
end)

describe("Format.signed, plural and percent", function()
	it("marks gains with + and losses with -", function()
		expect(Format.signed(8)).toBe("+8")
		expect(Format.signed(0)).toBe("+0")
		expect(Format.signed(-3)).toBe("-3")
		expect(Format.signed(2500)).toBe("+2,500")
	end)

	it("uses the singular only for exactly one", function()
		expect(Format.plural(1, "stop")).toBe("1 stop")
		expect(Format.plural(0, "stop")).toBe("0 stops")
		expect(Format.plural(2, "stop")).toBe("2 stops")
		expect(Format.plural(3, "crate", "crates of coal")).toBe("3 crates of coal")
		expect(Format.plural(1200, "coin")).toBe("1,200 coins")
	end)

	it("rounds a fraction to a whole percent", function()
		expect(Format.percent(0)).toBe("0%")
		expect(Format.percent(0.125)).toBe("13%")
		expect(Format.percent(1)).toBe("100%")
	end)
end)

local Config = require(Shared.Config.Injury)
local Injury = require(Shared.Logic.Injury)

describe("Injury", function()
	it("ships with the feature flag off", function()
		expect(Config.Enabled).toBe(false)
	end)

	it("takes the arm on the Hollow's side, never one already gone", function()
		local s = Injury.new()
		expect(Injury.targetArm(s, 1)).toBe("R")
		expect(Injury.targetArm(s, -1)).toBe("L")
		s = Injury.tear(s, "R", 0, false)
		expect(Injury.targetArm(s, 1)).toBe("L")
		s = Injury.tear(s, "L", 0, false)
		expect(Injury.targetArm(s, 1)).toBe(nil)
	end)

	it("ignores a duplicate tear", function()
		local s = Injury.tear(Injury.new(), "L", 0, false)
		local again = Injury.tear(s, "L", 5, false)
		expect(Injury.count(again)).toBe(1)
		expect(again.returnBy).toBe(nil)
	end)

	it("recomputes capacity from the uninjured capacity, never stacking", function()
		local s = Injury.new()
		expect(Injury.capacity(6, s)).toBe(6)
		s = Injury.tear(s, "L", 0, false)
		expect(Injury.capacity(6, s)).toBe(4)
		expect(Injury.capacity(8, s)).toBe(6) -- an upgrade lands after the injury
		expect(Injury.capacity(1, s)).toBe(0) -- clamped
		s = Injury.tear(s, "R", 0, false)
		expect(Injury.capacity(8, s)).toBe(0)
	end)

	it("starts the return deadline only when armless off the train", function()
		local s = Injury.tear(Injury.new(), "L", 0, false)
		expect(s.returnBy).toBe(nil)
		local off = Injury.tear(s, "R", 10, false)
		expect(off.returnBy).toBe(10 + Config.ReturnSeconds)
		local aboard = Injury.tear(s, "R", 10, true)
		expect(aboard.returnBy).toBe(nil)
	end)

	it("lets a heal or boarding at the deadline's instant win", function()
		local s = Injury.tear(Injury.tear(Injury.new(), "L", 0, false), "R", 0, false)
		local deadline = s.returnBy :: number
		expect(Injury.expired(s, deadline)).toBe(false)
		expect(Injury.expired(s, deadline + 0.001)).toBe(true)
		expect(Injury.expired(Injury.board(s), deadline + 1)).toBe(false)
		expect(Injury.expired(Injury.restore(s), deadline + 1)).toBe(false)
	end)

	it("boarding clears the deadline but grows no arm; leaving starts a fresh one", function()
		local s = Injury.tear(Injury.tear(Injury.new(), "L", 0, false), "R", 0, false)
		local safe = Injury.board(s)
		expect(Injury.count(safe)).toBe(2)
		expect(safe.returnBy).toBe(nil)
		local out = Injury.leave(safe, 100)
		expect(out.returnBy).toBe(100 + Config.ReturnSeconds)
		-- leaving again while a deadline runs keeps the running one
		expect(Injury.leave(out, 120).returnBy).toBe(100 + Config.ReturnSeconds)
	end)

	it("restores the last-lost arm first", function()
		local s = Injury.tear(Injury.tear(Injury.new(), "R", 0, false), "L", 0, false)
		expect(Injury.nextRestore(s)).toBe("L")
		s = Injury.restore(s)
		expect(Injury.missing(s, "R")).toBe(true)
		expect(Injury.missing(s, "L")).toBe(false)
		s = Injury.restore(Injury.restore(s))
		expect(Injury.count(s)).toBe(0)
	end)

	it("round-trips the replicated attribute", function()
		local s = Injury.tear(Injury.new(), "R", 0, false)
		expect(Injury.attribute(s)).toBe("R")
		s = Injury.tear(s, "L", 0, false)
		expect(Injury.attribute(s)).toBe("LR")
		expect(Injury.count(Injury.fromAttribute("LR"))).toBe(2)
		expect(Injury.count(Injury.fromAttribute(nil))).toBe(0)
		expect(Injury.canUseItems(s)).toBe(false)
	end)
end)

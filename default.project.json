{
  "name": "my-roblox-game",
  "globIgnorePaths": ["**/~syncthing~*", "**/.syncthing.*", "**/*.tmp"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "LoadingScreen": {
        "$path": "src/first/LoadingScreen.client.luau"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.149, 0.114, 0.075],
        "OutdoorAmbient": [0.149, 0.114, 0.086],
        "Brightness": 0,
        "ExposureCompensation": -0.1,
        "EnvironmentDiffuseScale": 0,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "ClockTime": 19
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -500
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}

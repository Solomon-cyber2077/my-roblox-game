--!strict
--[[
	How each biome looks and what its air is like. The landscape builders read
	the ground, relief and prop tables; AtmosphereController reads the weather,
	clouds and air tint. Biome ids come from Logic/Journey.

	The palette is stylised, not photographic: an autumn countryside going to
	ruin, pitched a little richer than life so it survives the dusk and night
	grade. Prop weights are relative within a list. Weather kinds: None, Ash,
	Snow, Rain (drizzle drawn as squashed sparkles) and Embers.
]]

export type Weighted = { kind: string, weight: number }

export type Def = {
	id: string,
	ground: Color3,
	groundMaterial: Enum.Material,
	patches: { Color3 },
	patchMaterials: { Enum.Material },
	fields: { Color3 }?, -- strips across the track (farmland)
	hill: Color3,
	ridge: Color3, -- near horizon hills
	mountain: Color3, -- the far range
	snowcap: boolean,
	rock: Color3,
	foliage: { Color3 },
	trunk: Color3,
	tufts: Color3,
	near: { Weighted }, -- near-field props
	mid: { Weighted }, -- mid-field clumps
	eerie: { Weighted }, -- rare sights near the line (lone graves, a lantern, something standing)
	nearCount: number, -- props per near chunk side at full density
	midCount: number, -- props per mid chunk side at full density
	mounds: number, -- buried-ball mounds per near chunk side
	hedges: boolean, -- hedgerows between fields and along the line
	pylons: boolean, -- a power line marches across the mid field
	belt: string?, -- forest belt kind in the mid field
	sea: boolean, -- the platform side opens onto the sea
	-- the air
	weather: string,
	weatherRate: number,
	storm: boolean,
	cloudCover: number,
	cloudDensity: number,
	cloudColor: Color3,
	tint: Color3, -- multiplies the Atmosphere colour
	density: number, -- added to the Atmosphere density
	haze: number, -- added to the Atmosphere haze
}


local Biomes = {}

function Biomes.get(id: string): Def
	return Defs[id] or Defs.Corridor
end

function Biomes.ids(): { string }
	local ids: { string } = {}
	for id in Defs do
		table.insert(ids, id)
	end
	table.sort(ids)
	return ids
end

return Biomes
